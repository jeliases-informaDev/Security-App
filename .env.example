# Copialo como ".env.local" en esta carpeta (".env.local" no se sube a git).
# Es OPCIONAL: sin este archivo la app usa 10.0.2.2 (emulador Android) o localhost (iOS / web).
# Despues de cambiarlo reinicia Expo con:  npx expo start -c

# URL del backend (incluye /api). Para un celular fisico usa la IP de tu PC en la red Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8081/api/
